---
import { brand } from '../config/brand';
import { client } from '../data/client';

const year = new Date().getFullYear();

const services = [
  'Residential Electrical',
  'Commercial Electrical',
  'Light Commercial',
  'New Construction',
  'Home Remodels',
  'Panel Upgrades',
  'Service Upgrades',
  'EV Charger Installation',
  'Generator & Backup Power',
  'Pool Wiring',
  'Low Voltage Lighting',
  'Troubleshooting',
  'Safety Inspections',
];

const navCols = [
  {
    title: 'Company',
    links: [
      { label: 'About',    href: '/about' },
      { label: 'Services', href: '/services' },
      { label: 'Contact',  href: '/contact' },
    ],
  },
  {
    title: 'Services',
    links: services.map((service) => ({ label: service, href: '/services' })),
  },
];
---

<footer class="bg-black text-surface/80" transition:persist>
  <div class="mx-auto max-w-site px-4 py-12 sm:px-6 lg:py-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">

      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">{brand.name}</h3>
        <p class="mt-3 max-w-xs text-sm leading-relaxed">
          {brand.tagline}
        </p>
      </div>

      <!-- Nav columns -->
      {navCols.map((col) => (
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-white">{col.title}</h3>
          <ul class="mt-3 space-y-2">
            {col.links.map(({ label, href }) => (
              <li>
                <a href={href} class="text-sm transition-colors hover:text-white">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Contact info -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">Contact</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href={`tel:${client.phoneForTel}`} class="transition-colors hover:text-white">
              {client.phoneFormatted}
            </a>
          </li>
          <li>
            <a href={`mailto:${client.email}`} class="transition-colors hover:text-white">
              {client.email}
            </a>
          </li>
          <li>
            <a href={client.address.mapLink} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white">
              {client.address.lineOne && <>{client.address.lineOne}<br /></>}
              {client.address.city}, {client.address.state} {client.address.zip}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-10 border-t border-surface/10 pt-6 text-center text-sm">
      <p>&copy; {year} {brand.name}. All rights reserved.</p>
      <p class="mt-2 text-surface/60">
        Website by{' '}
        <a
          href="https://shorelinewebsolutions.com"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-white"
        >
          Shoreline Web Solutions
        </a>
      </p>
    </div>
  </div>
</footer>
