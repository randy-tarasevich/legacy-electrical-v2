---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';

const serviceCategories = [
  {
    title: 'Electrical Systems & Upgrades',
    items: [
      'Electrical service upgrades',
      'Electrical panel replacement',
      'Electrical subpanel installation',
      'Premium surge protectors',
      'Grounding electrode systems',
      'Electrical conduit installation',
    ],
  },
  {
    title: 'Lighting & Electrical Outlets',
    items: [
      'Receptacle & lighting installation',
      'Ceiling fan installation',
      'Bathroom exhaust fan installation',
      'TV wall mount installation',
      'Low-voltage doorbell installation',
    ],
  },
  {
    title: 'Safety & Security',
    items: [
      'Smoke/CO detector installations',
      'Security camera installation',
      'Safety inspections',
      'Generator system installation',
    ],
  },
  {
    title: 'Specialized Services',
    items: [
      'EV charging station installation',
      'HVAC equipment wiring',
      'Detached garage and shed wiring',
      'Additions & remodels',
      'Existing work & new construction',
      'Jacuzzi & hot tub installation',
    ],
  },
];

---

<BaseLayout title="Services" description={`Explore residential and light commercial electrical services from ${brand.name}, from diagnostics and repairs to upgrades and installations.`}>
  <Header slot="header" />

  <Banner title="Our Services" />

  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Detailed Service Offerings</h2>
        <p class="mt-3 text-text-muted leading-relaxed">
          Full-scope residential electrical services for upgrades, installations, and safety-focused improvements.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {serviceCategories.map((category) => (
          <div class="rounded-xl border border-border bg-background p-6 shadow-sm">
            <h3 class="font-heading text-h3 font-semibold text-text">{category.title}</h3>
            <ul class="mt-5 space-y-3">
              {category.items.map((item) => (
                <li class="flex items-start gap-3 text-text-muted">
                  <svg class="mt-0.5 size-5 shrink-0 text-emerald-500" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.8" />
                    <path d="m7.2 10.1 1.9 1.9 3.7-4.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
