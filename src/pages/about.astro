---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { Image } from 'astro:assets';
import { brand } from '../config/brand';
import { aboutImage } from '../config/images';
import aboutPlaceholder from '../assets/images/about/img_2173.webp';
---

<BaseLayout title="About Us" description={`Learn about ${brand.name} and Tayler, committed to safe electrical work, honest communication, and dependable service.`}>
  <Header slot="header" />

  <Banner title="About Us" variant="light" />

  <!-- Story -->
  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
      <div class="overflow-hidden rounded-lg shadow-lg">
        <Image
          src={aboutImage ?? aboutPlaceholder}
          alt="Legacy Electrical job site"
          width={800}
          height={600}
          loading="lazy"
          class="size-full object-cover"
        />
      </div>
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Our Story</span>
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Built on safety, powered by trust</h2>
        <p class="text-text-muted leading-relaxed">
          Legacy Electrical started as a one-person operation and has grown into a trusted local team serving homeowners and small businesses across Berlin, CT. For more than 15 years, we have focused on doing the job right and treating people fairly.
        </p>
        <p class="text-text-muted leading-relaxed">
          Every technician is licensed and insured, and every project is completed with safety-first standards. We arrive prepared, explain options clearly, and leave your space clean when the work is done.
        </p>
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
